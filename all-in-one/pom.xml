<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.triform</groupId>
        <artifactId>triform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>all-in-one</artifactId>

    <description>mono 单体入口: 全部服务装进一个进程, 跨服务调用走本地 Bean</description>
    <dependencies>
        <dependency>
            <groupId>io.triform</groupId>
            <artifactId>sample-echo</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.triform</groupId>
            <artifactId>sample-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.2.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 双产物: 普通 jar 供 all-in-one 依赖; 带 classifier 的可执行 jar 供 micro 独立部署 -->
                    <classifier>exec</classifier>
                    <mainClass>io.triform.sample.allinone.SampleAllInOneApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
