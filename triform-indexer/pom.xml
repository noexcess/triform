<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.triform</groupId>
        <artifactId>triform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>triform-indexer</artifactId>
    <description>编译期 Facade 索引生成器(E3): api 模块以 provided 依赖引入, 自动在 CLASS_OUTPUT 生成 META-INF/triform-facades——索引维护负担归零(学 spring-context-indexer 模式)</description>
    <dependencies>
        <!-- 只需注解类; provided 不传递给下游 -->
        <dependency>
            <groupId>io.triform</groupId>
            <artifactId>triform-rpc</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 自举: 编译处理器自身时禁用注解处理, 避免 ServiceLoader 加载未编译完成的自己 -->
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
